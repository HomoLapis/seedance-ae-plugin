# Default: let git decide based on content
* text=auto

# Shell scripts MUST stay LF (executed on macOS/Linux)
*.sh         text eol=lf

# Batch scripts MUST stay CRLF (executed on Windows cmd.exe)
*.bat        text eol=crlf
*.cmd        text eol=crlf

# Source files: normalize to LF in repo, working tree converts on Windows
*.js         text eol=lf
*.jsx        text eol=lf
*.json       text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.md         text eol=lf
*.xml        text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf

# Binary
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.zip        binary
*.zxp        binary
